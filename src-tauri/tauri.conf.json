{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tsuru",
  "version": "0.0.2",
  "identifier": "com.tsuru.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tsuru",
        "width": 1120,
        "height": 920,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/kevinchrist20/Tsuru/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFQUUzMEZFQkNBNjU1MjQKUldRa1ZhYTgvakN1UHJ5a0RTYk5jN3VhWWVpMUZBemJYYTBqWFdEeE91NTFTVXlwcmQ1ZUNOUFQK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
